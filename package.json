{
  "name": "personaboard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "desktop:dev": "pnpm -F desktop desktop:dev",
    "desktop:build": "pnpm -F desktop desktop:build",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @personaboard/db",
    "db:studio": "turbo run db:studio -F @personaboard/db",
    "db:generate": "turbo run db:generate -F @personaboard/db",
    "db:migrate": "turbo run db:migrate -F @personaboard/db"
  },
  "dependencies": {
    "@personaboard/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@personaboard/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "^6"
  },
  "packageManager": "pnpm@11.4.0"
}
