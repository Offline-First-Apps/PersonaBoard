# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:password@localhost:5432/personaboard

# Comma-separated origins allowed to make CORS requests (the web app URL)
CORS_ORIGIN=http://localhost:3001

# Port the server listens on (Bun convention, app code does not read it directly)
# PORT=3000

# Node environment (development | production | test)
# NODE_ENV=development

# Set to "1" to skip t3-env validation
# SKIP_ENV_VALIDATION=1
