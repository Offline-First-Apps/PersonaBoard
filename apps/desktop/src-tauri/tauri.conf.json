{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PersonaBoard",
  "version": "0.1.0",
  "identifier": "com.personaboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PersonaBoard",
        "width": 1000,
        "height": 780,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": true,
        "center": true,
        "skipTaskbar": false
      },
      {
        "label": "toast",
        "title": "",
        "url": "/?window=toast",
        "width": 320,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
