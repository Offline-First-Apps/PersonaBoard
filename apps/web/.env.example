# URL of the backend server (used at build time — prefix MUST be NEXT_PUBLIC_)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public URL of the Windows installer (e.g. R2 public bucket URL)
NEXT_PUBLIC_DOWNLOAD_URL=https://pub-abcdef123456.r2.dev/PersonaBoard-Setup.exe

# Set to "1" to skip t3-env validation at build time
# SKIP_ENV_VALIDATION=1
